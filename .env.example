# Pooled Neon connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Direct Neon connection used only by Prisma migrations and administrative tasks.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Enable only when the deployment platform is trusted to overwrite proxy headers.
# Required as "true" in production when MCP_ENABLED=true (per-IP rate limits).
TRUST_PROXY_HEADERS="false"

# Opt-in performance telemetry. Logs contain only route/model/action, status and timings.
PERFORMANCE_LOGS="false"
PERFORMANCE_SLOW_QUERY_MS="100"
NEXT_PUBLIC_PERFORMANCE_LOGS="false"

# Remote MCP (read-only). Disabled by default. In production MCP_PUBLIC_BASE_URL
# is mandatory and must be the public HTTPS origin of this application.
MCP_ENABLED="false"
MCP_PUBLIC_BASE_URL="https://app.example.com"
# Optional extra browser origins allowed to call the MCP endpoint (CSV).
MCP_ALLOWED_ORIGINS=""
# Durations and budgets. Refresh tokens never exceed 30 days.
MCP_ACCESS_TOKEN_TTL_SECONDS="900"
MCP_REFRESH_TOKEN_TTL_DAYS="30"
MCP_AUTH_CODE_TTL_SECONDS="300"
MCP_TOOL_RATE_LIMIT_PER_MINUTE="60"
MCP_SEARCH_RATE_LIMIT_PER_MINUTE="30"
MCP_REQUEST_RATE_LIMIT_PER_MINUTE="300"
MCP_AUTH_RATE_LIMIT_PER_MINUTE="30"
# Response shaping. Media URLs are omitted unless explicitly enabled and allowlisted.
MCP_DEFAULT_PAGE_SIZE="20"
MCP_MAX_PAGE_SIZE="100"
MCP_MAX_CONTENT_CHARS="50000"
MCP_MAX_ARGUMENT_BYTES="65536"
MCP_MAX_RESPONSE_BYTES="262144"
MCP_EXPOSE_MEDIA_URLS="false"
MCP_ALLOWED_MEDIA_HOSTS=""
